{
  "name": "sparrowhawk-electron",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev:renderer": "npm --prefix ../www run serve",
    "dev:electron": "wait-on tcp:8080 && cross-env ELECTRON_RENDERER_URL=http://localhost:8080 electron .",
    "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:electron\"",
    "build:renderer": "npm --prefix ../www run build:electron",
    "build": "npm run build:renderer && electron-builder",
    "build:linux": "npm run build:renderer && electron-builder --linux",
    "build:mac": "npm run build:renderer && electron-builder --mac",
    "build:win": "npm run build:renderer && electron-builder --win",
    "start": "electron ."
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^43.3.0",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "org.bacpop.sparrowhawk",
    "productName": "Sparrowhawk",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "afterPack": "./afterPack.js",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      {
        "from": "../www/dist-electron",
        "to": "renderer",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Science"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
